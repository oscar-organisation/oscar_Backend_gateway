#!/usr/bin/env bash
set -Eeuo pipefail

home="${OSCAR_HOME:-/opt/oscar/current}"
config="${OSCAR_CONFIG_FILE:-/etc/oscar/robot.env}"
release="${OSCAR_RELEASE_FILE:-/etc/oscar/release.env}"
compose=(docker compose --env-file "$config" --env-file "$release" -f "$home/compose.yaml")
compose_build=(docker compose --env-file "$config" --env-file "$release" -f "$home/compose.build.yaml")

usage() {
  cat <<'EOF'
Usage: oscarctl COMMAND

  preflight  Valider l'hote, la configuration et les credentials
  activate   Tirer l'image, activer au demarrage et lancer OSCAR Edge
  pull       Tirer l'image de la release installee depuis le registre
  ensure     Rattraper un runtime disparu, ou muet malgre ses processus
  start      Lancer le runtime
  stop       Arreter le runtime et publier un arret via l'agent
  restart    Redemarrer proprement le runtime
  status     Afficher l'etat systemd et conteneur
  doctor     Executer le prevol puis le diagnostic ROS/runtime
  sync       Reconcilier maintenant avec le bundle publie
  upgrade    Chercher et appliquer une nouvelle version du paquet
  bundle     Afficher le bundle applique sur ce robot
  logs       Suivre les journaux des agents
  releases   Lister les releases installees
  rollback   Revenir a une release deja installee
  version    Afficher la version installee
  image      Afficher l'image attendue et son empreinte locale

Robot de reference uniquement :
  build-image [--local]  Construire l'image de cette release et la pousser
EOF
}

case "${1:-}" in
  preflight)
    exec /usr/local/libexec/oscar-preflight
    ;;
  activate)
    # La reference est recalculee ici : sur une premiere installation,
    # l'operateur a renseigne le registre dans robot.env apres install.sh.
    /usr/local/libexec/oscar-release-env "$home"
    # Le tirage precede le prevol : celui-ci verifie desormais que l'image
    # attendue est bien sur le disque, ce qu'elle n'est pas avant.
    "$0" pull
    /usr/local/libexec/oscar-preflight
    systemctl enable --now oscar-edge-bridge.service oscar-edge.service oscar-edge-health.timer oscar-edge-network.timer
    # La reconciliation n'est activee que si le robot sait a qui parler : sans
    # OSCAR_API_URL, la minuterie echouerait a chaque passage pour rien.
    if grep -qs '^OSCAR_API_URL=.\+' "$config"; then
      systemctl enable --now oscar-edge-sync.timer oscar-edge-release.timer oscar-edge-credentials.timer
    else
      echo "OSCAR_API_URL absent de $config : reconciliation des bundles non activee."
    fi
    ;;
  pull)
    # L'image est deja la sur un robot qui n'a pas change de version : on ne
    # retelecharge rien pour rien, et surtout on ne depend pas du reseau pour
    # un simple redemarrage.
    image="$(grep -s '^OSCAR_EDGE_IMAGE=' "$release" | tail -1 | cut -d= -f2-)"
    if [[ -z "$image" ]]; then
      echo "OSCAR_EDGE_IMAGE absent de $release : paquet installe ?" >&2
      exit 1
    fi
    if docker image inspect "$image" >/dev/null 2>&1; then
      echo "Image deja presente: $image"
    else
      echo "Tirage de $image"
      docker pull "$image"
    fi
    ;;
  image)
    image="$(grep -s '^OSCAR_EDGE_IMAGE=' "$release" | tail -1 | cut -d= -f2-)"
    printf 'attendue : %s\n' "${image:-<absente>}"
    if [[ -n "$image" ]] && docker image inspect "$image" >/dev/null 2>&1; then
      printf 'locale   : %s\n' \
        "$(docker image inspect --format '{{index .RepoDigests 0}}' "$image" 2>/dev/null \
           || docker image inspect --format '{{.Id}}' "$image")"
    else
      printf 'locale   : absente\n'
    fi
    ;;
  build-image)
    # Reserve au robot de reference : celui qui porte l'image constructeur et
    # les identifiants d'ecriture du registre. Les autres tirent le resultat.
    image="$(grep -s '^OSCAR_EDGE_IMAGE=' "$release" | tail -1 | cut -d= -f2-)"
    if [[ -z "$image" ]]; then
      echo "OSCAR_EDGE_IMAGE absent de $release : paquet installe ?" >&2
      exit 1
    fi
    "${compose_build[@]}" build edge
    if [[ "${2:-}" == "--local" ]]; then
      echo "Image construite sans etre poussee: $image"
      exit 0
    fi
    docker push "$image"
    printf 'Image poussee: %s\n' \
      "$(docker image inspect --format '{{index .RepoDigests 0}}' "$image")"
    ;;
  ensure)
    # Filet de securite, appele par la minuterie de sante. Il traite deux
    # pannes distinctes, et l'escalade compte : relancer un runtime dont le
    # peripherique est bloque ne sert a rien, mais reinitialiser un port USB
    # a chaque hoquet serait brutal.
    systemctl is-active --quiet oscar-edge.service || exit 0
    marqueur="/var/lib/oscar/reprise-media"

    etat="$(docker inspect -f '{{.State.Status}}' oscar-edge 2>/dev/null || echo absent)"
    if [[ "$etat" != "running" ]]; then
      echo "Runtime $etat alors que le service est actif : relance." >&2
      rm -f "$marqueur"
      "${compose[@]}" up --detach --force-recreate edge
      exit 0
    fi

    sante="$(docker inspect -f '{{if .State.Health}}{{.State.Health.Status}}{{end}}' oscar-edge 2>/dev/null)"
    # Seul un retour a la sante efface le compteur. Pendant « starting », on
    # attend sans rien effacer : chaque relance rouvre une periode de grace, et
    # remettre le compteur a zero a ce moment-la empechait l'escalade de jamais
    # se declencher. Le runtime se relancait en boucle sans que la cause
    # materielle ne soit traitee.
    if [[ "$sante" == "healthy" ]]; then
      rm -f "$marqueur"
      exit 0
    fi
    [[ "$sante" == "unhealthy" ]] || exit 0

    tentatives=$(( $(cat "$marqueur" 2>/dev/null || echo 0) + 1 ))
    echo "$tentatives" > "$marqueur"

    if (( tentatives >= 2 )); then
      # Le runtime a deja ete relance sans succes. Sur ce chassis, la session
      # USB de la camera ne se retablit pas toute seule apres un redemarrage
      # de conteneur : le noeud ROS demarre et n'initialise jamais le
      # peripherique. Seul un cycle du port le debloque, et il doit se faire
      # depuis l'hote, /sys n'etant pas inscriptible dans le conteneur.
      vendeurs="$(sed -n 's/^OSCAR_USB_RECOVERY_VENDORS=//p' "$config" | tail -1 | tr -d '"')"
      for vendeur in $vendeurs; do
        for chemin in /sys/bus/usb/devices/*; do
          [[ "$(cat "$chemin/idVendor" 2>/dev/null)" == "$vendeur" ]] || continue
          echo "Reinitialisation du port USB $(basename "$chemin") (vendeur $vendeur)." >&2
          echo 0 > "$chemin/authorized" 2>/dev/null || true
          sleep 2
          echo 1 > "$chemin/authorized" 2>/dev/null || true
        done
      done
      rm -f "$marqueur"
    fi

    echo "Runtime en mauvaise sante (tentative $tentatives) : relance." >&2
    "${compose[@]}" up --detach --force-recreate edge
    ;;
  start)
    systemctl start oscar-edge.service
    ;;
  stop)
    systemctl stop oscar-edge.service
    ;;
  restart)
    systemctl restart oscar-edge.service
    ;;
  status)
    systemctl --no-pager --full status oscar-edge.service || true
    "${compose[@]}" ps || true
    ;;
  doctor)
    /usr/local/libexec/oscar-preflight
    exec /usr/local/bin/oscar-healthcheck
    ;;
  logs)
    exec "${compose[@]}" logs --follow --tail 200 edge
    ;;
  sync)
    shift
    exec /usr/local/libexec/oscar-bundle-sync "$@"
    ;;
  upgrade)
    shift
    exec /usr/local/libexec/oscar-release-sync "$@"
    ;;
  bundle)
    applied="/var/lib/oscar/bundle-applied.json"
    if [[ -f "$applied" ]]; then
      cat "$applied"
    else
      echo "Aucun bundle applique sur ce robot."
    fi
    ;;
  releases)
    current="$(readlink -f /opt/oscar/current 2>/dev/null || true)"
    for release in /opt/oscar/releases/*; do
      [[ -d "$release" ]] || continue
      marker=" "
      [[ "$(readlink -f "$release")" == "$current" ]] && marker="*"
      printf '%s %s\n' "$marker" "$(basename "$release")"
    done
    ;;
  rollback)
    target="${2:-}"
    if [[ -z "$target" || ! -d "/opt/oscar/releases/$target" ]]; then
      echo "Usage: oscarctl rollback VERSION_INSTALLEE" >&2
      exit 2
    fi
    previous="$(readlink -f /opt/oscar/current)"
    systemctl stop oscar-edge.service
    ln -sfn "/opt/oscar/releases/$target" /opt/oscar/current
    if ! /usr/local/libexec/oscar-preflight || ! systemctl start oscar-edge.service; then
      ln -sfn "$previous" /opt/oscar/current
      systemctl start oscar-edge.service
      echo "Retour arriere refuse; release precedente restauree." >&2
      exit 1
    fi
    echo "Release active: $target"
    ;;
  version)
    cat "$home/VERSION"
    ;;
  *)
    usage
    exit 2
    ;;
esac
