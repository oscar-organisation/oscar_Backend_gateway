{
  "name": "oscar-edge",
  "version": "0.6.0",
  "contractVersion": 1,
  "supportedArchitectures": [
    "aarch64",
    "x86_64"
  ],
  "supportedRosDistributions": [
    "humble"
  ],
  "agents": [
    "media",
    "command"
  ],
  "livekit": {
    "inputTopic": "oscar.xr.input",
    "commandEchoTopic": "oscar.robot.command",
    "videoTrack": "camera-front"
  },
  "safety": {
    "deadmanRequired": true,
    "watchdogMs": 300,
    "motionOnBoot": false,
    "chassisStopMs": 300
  },
  "bundleSync": {
    "format": "oscar.bundle.runtime.v1",
    "intervalSeconds": 45
  },
  "bringup": {
    "source": "composition+profile",
    "variables": "OSCAR_BRINGUP_<BESOIN>",
    "runsIn": "oscar-chassis"
  },
  "releaseSync": {
    "intervalMinutes": 10,
    "verification": "sha256 + HMAC par cle robot"
  },
  "image": {
    "repository": "oscar/edge-<distribution ROS>",
    "reference": "empreinte sha256, /etc/oscar/release.env",
    "builtOn": "CI GitHub, linux/arm64",
    "signature": "cosign, cle publique config/cosign.pub"
  },
  "sante": {
    "preuve": "publication effective",
    "reprise": "relance puis reinitialisation du port USB"
  },
  "chassis": {
    "image": "ROBOT_BASE_IMAGE, livree avec le robot, jamais tiree",
    "conteneur": "oscar-chassis",
    "contenu": "pilotes du constructeur + arret de securite"
  }
}
