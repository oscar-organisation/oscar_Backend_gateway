# Identite canonique attribuee par la plateforme de deploiement.
OSCAR_ROBOT_ID=oscar-02
OSCAR_ROBOT_PROFILE=rosmaster-m3pro

# La version du runtime n'est plus ici : le paquet l'ecrit lui-meme dans
# /etc/oscar/release.env a chaque installation. Une valeur tenue a la main
# restait figee pendant que le paquet montait, et le robot relancait alors
# l'ancienne image.

# Console qui publie les bundles. Le robot tire sa configuration depuis cette
# adresse ; la cle d'agent vit a part, dans /etc/oscar/credentials/agent.key,
# car ce fichier-ci est injecte dans le conteneur.
OSCAR_API_URL=https://api-admin.oscar-bot.com/api

# Registre d'ou vient l'image du runtime. Joignable par le seul tailnet.
OSCAR_REGISTRY=oscar-vps.taild29717.ts.net:5000

# Image constructeur contenant ROS 2 Humble et les messages du robot.
# Utile au seul robot de reference, celui qui fabrique l'image de la flotte ;
# un robot ordinaire tire l'image finie et n'a pas besoin de cette base.
ROBOT_BASE_IMAGE=CHANGE_ME_VENDOR_ROS_IMAGE
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
OSCAR_ROS_SETUP=/opt/ros/humble/setup.bash
OSCAR_VENDOR_SETUP=/root/ros2_ws/install/setup.bash

# Contrat ROS du profil.
OSCAR_CAMERA_TOPIC=/camera/color/image_raw
OSCAR_CMD_VEL_TOPIC=/cmd_vel
OSCAR_ARM_TOPIC=/arm_joint

# Profil video valide sur Jetson Nano.
OSCAR_CAMERA_WIDTH=640
OSCAR_CAMERA_HEIGHT=480
OSCAR_CAMERA_FPS=30
OSCAR_CAMERA_MAX_BITRATE=1500000
OSCAR_CAMERA_ROTATE_180=true
OSCAR_VIDEO_TRACK=camera-front

# Contrat de teleoperation et limites embarquees.
OSCAR_INPUT_TOPIC=oscar.xr.input
OSCAR_COMMAND_ECHO_TOPIC=oscar.robot.command
OSCAR_WATCHDOG_MS=300
OSCAR_CONTROL_HZ=30
OSCAR_MAX_VX_MPS=0.40
OSCAR_MAX_VY_MPS=0.20
OSCAR_MAX_WZ_RADPS=0.80
OSCAR_INVERT_LATERAL=false

# Peripheriques USB que la reprise automatique peut reinitialiser, par
# identifiant de vendeur. Sur ce chassis la session USB de la camera ne se
# retablit pas apres un redemarrage de conteneur : le noeud ROS demarre et
# n'initialise jamais le peripherique. Seul un cycle du port le debloque.
# Laisser vide desactive la reprise materielle.
OSCAR_USB_RECOVERY_VENDORS=

# Les JWT ne sont jamais places ici. Ils sont montes en lecture seule.
OSCAR_MEDIA_TOKEN_FILE=/run/secrets/oscar/media.json
OSCAR_COMMAND_TOKEN_FILE=/run/secrets/oscar/command.json
LOG_LEVEL=INFO

# Optionnel mais recommande sur les Wi-Fi restrictifs : noeud de sortie stable.
OSCAR_TAILSCALE_EXIT_NODE=oscar-vps
