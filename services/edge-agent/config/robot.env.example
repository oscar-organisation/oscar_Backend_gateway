# Identite canonique attribuee par la plateforme de deploiement.
OSCAR_ROBOT_ID=oscar-02
OSCAR_ROBOT_PROFILE=rosmaster-m3pro
OSCAR_EDGE_VERSION=0.1.0

# Image constructeur contenant ROS 2 Humble et les messages du robot.
ROBOT_BASE_IMAGE=CHANGE_ME_VENDOR_ROS_IMAGE
ROS_DISTRO=humble
ROS_DOMAIN_ID=0
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
OSCAR_ROS_SETUP=/opt/ros/humble/setup.bash
OSCAR_VENDOR_SETUP=/root/ros2_ws/install/setup.bash

# Contrat ROS du profil.
OSCAR_CAMERA_TOPIC=/camera/color/image_raw
OSCAR_CMD_VEL_TOPIC=/cmd_vel
OSCAR_ARM_TOPIC=/arm_joint

# Profil video valide sur Jetson Nano.
OSCAR_CAMERA_WIDTH=640
OSCAR_CAMERA_HEIGHT=480
OSCAR_CAMERA_FPS=30
OSCAR_CAMERA_MAX_BITRATE=1500000
OSCAR_CAMERA_ROTATE_180=true
OSCAR_VIDEO_TRACK=camera-front

# Contrat de teleoperation et limites embarquees.
OSCAR_INPUT_TOPIC=oscar.xr.input
OSCAR_COMMAND_ECHO_TOPIC=oscar.robot.command
OSCAR_WATCHDOG_MS=300
OSCAR_CONTROL_HZ=30
OSCAR_MAX_VX_MPS=0.40
OSCAR_MAX_VY_MPS=0.20
OSCAR_MAX_WZ_RADPS=0.80
OSCAR_INVERT_LATERAL=false

# Les JWT ne sont jamais places ici. Ils sont montes en lecture seule.
OSCAR_MEDIA_TOKEN_FILE=/run/secrets/oscar/media.json
OSCAR_COMMAND_TOKEN_FILE=/run/secrets/oscar/command.json
LOG_LEVEL=INFO
