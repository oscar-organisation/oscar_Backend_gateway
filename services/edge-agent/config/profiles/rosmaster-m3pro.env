# Profil materiel ROSMASTER M3 Pro / Jetson Nano / ROS 2 Humble.
#
# Ce fichier decrit COMMENT ce chassis est cable et comment on le met en route.
# Ce qui tourne dessus est decide ailleurs, par le bundle publie depuis la
# console (/etc/oscar/bundle.env).
OSCAR_ROBOT_PROFILE=rosmaster-m3pro
ROS_DISTRO=humble
RMW_IMPLEMENTATION=rmw_fastrtps_cpp
# Transport force en UDPv4 : la decouverte par multicast ne passe pas sur ce
# materiel, et la memoire partagee ne traverse pas la frontiere des conteneurs.
FASTDDS_BUILTIN_TRANSPORTS=UDPv4
ROS_DOMAIN_ID=30
OSCAR_ROS_SETUP=/opt/ros/humble/setup.bash
OSCAR_VENDOR_SETUP=/root/M3Pro_ws/install/setup.bash

# --- Contrat ROS du chassis ------------------------------------------------
OSCAR_CAMERA_TOPIC=/camera/color/image_raw
OSCAR_CMD_VEL_TOPIC=/cmd_vel
OSCAR_ARM_TOPIC=/arm_joint

# --- Mise en route du chassis ----------------------------------------------
# Sur un robot sorti de carton, rien n'est lance : ces commandes reveillent les
# pilotes avant que les agents ne s'abonnent. Elles appartiennent au profil, pas
# au bundle : un autre chassis les remplace sans toucher aux compositions.
OSCAR_BRINGUP_COUNT=2
OSCAR_BRINGUP_1=ros2 launch M3Pro_navigation base_bringup.launch.py
OSCAR_BRINGUP_1_DELAY=8
# La DaBai est sur USB 2.0 : profondeur et infrarouge se partageaient la bande
# passante avec la couleur sans aucun abonne. Les couper fait passer la cadence
# de 8,8 a 10 images par seconde (mesure du 28/08/2026).
OSCAR_BRINGUP_2=ros2 launch orbbec_camera dabai_dcw2.launch.py color_width:=640 color_height:=480 color_fps:=30 enable_depth:=false enable_ir:=false enable_point_cloud:=false enable_colored_point_cloud:=false depth_registration:=false
OSCAR_BRINGUP_2_DELAY=10

# --- Pont micro-ROS vers la carte de commande ------------------------------
COMPOSE_PROFILES=microros
OSCAR_MICROROS_IMAGE=192.168.2.51:5000/micro-ros-agent:humble
# Chemin stable par identifiant : le numero de /dev/ttyUSB* change d'un
# branchement a l'autre, pas celui-ci.
OSCAR_MICROROS_ARGS=serial --dev /dev/serial/by-id/usb-Silicon_Labs_CP2104_USB_to_UART_Bridge_Controller_02C4DDE4-if00-port0 -b 2000000 -v4

# --- Profil video et teleoperation -----------------------------------------
OSCAR_CAMERA_WIDTH=640
OSCAR_CAMERA_HEIGHT=480
OSCAR_CAMERA_FPS=30
OSCAR_CAMERA_MAX_BITRATE=1200000
OSCAR_VIDEO_TRACK=camera-front
OSCAR_INPUT_TOPIC=oscar.xr.input
OSCAR_COMMAND_ECHO_TOPIC=oscar.robot.command
OSCAR_INVERT_LATERAL=true
OSCAR_MAX_VX_MPS=0.40
OSCAR_MAX_VY_MPS=0.20
OSCAR_MAX_WZ_RADPS=0.80
OSCAR_WATCHDOG_MS=300
OSCAR_CONTROL_HZ=30
LOG_LEVEL=INFO
