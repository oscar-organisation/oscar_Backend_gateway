[Unit]
Description=Renouvellement quotidien des identifiants LiveKit OSCAR

[Timer]
# Le passage nocturne evite une coupure video en pleine exploitation. Le delai
# aleatoire repartit les appels API et les redemarrages dans une flotte.
OnCalendar=*-*-* 03:00:00
RandomizedDelaySec=60min
AccuracySec=15min
Persistent=true

[Install]
WantedBy=timers.target
