[Unit]
Description=OSCAR Edge peripheral bridges
Documentation=file:/opt/oscar/current/docs/protocole-deploiement-embarque.md
Wants=network-online.target docker.service
After=network-online.target docker.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/oscar/current
# Les ponts vers les peripheriques vivent hors du cycle des bundles. La carte de
# commande ne retablit pas sa session quand son agent redemarre : un changement
# de composition ne doit donc jamais la toucher, seulement le runtime.
ExecStart=/usr/bin/docker compose --env-file /etc/oscar/robot.env --env-file /etc/oscar/release.env -f /opt/oscar/current/compose.yaml --profile microros up --detach microros
ExecStop=/usr/bin/docker compose --env-file /etc/oscar/robot.env --env-file /etc/oscar/release.env -f /opt/oscar/current/compose.yaml stop --timeout 5 microros
TimeoutStartSec=180

[Install]
WantedBy=multi-user.target
