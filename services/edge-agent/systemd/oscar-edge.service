[Unit]
Description=OSCAR Edge Runtime
Wants=network-online.target docker.service
After=network-online.target docker.service oscar-edge-bridge.service

[Service]
# --force-recreate ci-dessous n'est pas une precaution de style. Sans lui,
# « up » se contente de constater : si l'ancien conteneur n'a pas fini de
# mourir, compose le voit « Running », ne fait rien, et personne ne demarre le
# nouveau quand l'ancien disparait enfin. Une relance a coute cinq minutes
# d'arret ce jour-la.
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/opt/oscar/current
ExecStartPre=/usr/local/bin/oscarctl preflight
ExecStart=/usr/bin/docker compose --env-file /etc/oscar/robot.env --env-file /etc/oscar/release.env -f /opt/oscar/current/compose.yaml up --detach --force-recreate edge
ExecStop=/usr/bin/docker compose --env-file /etc/oscar/robot.env --env-file /etc/oscar/release.env -f /opt/oscar/current/compose.yaml stop --timeout 25 edge
TimeoutStartSec=300
TimeoutStopSec=20

[Install]
WantedBy=multi-user.target
