[Unit]
Description=Recherche periodique d'une nouvelle version du paquet embarque

[Timer]
# Dix minutes : une mise a jour de code n'a pas l'urgence d'un changement de
# configuration, et telecharger une archive coute plus cher qu'un appel JSON.
OnBootSec=3min
OnUnitActiveSec=10min
AccuracySec=30s
Persistent=true

[Install]
WantedBy=timers.target
